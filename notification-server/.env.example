# ============================================================
# Eventra Notification Server Environment Configuration
# ============================================================

# 1. Firebase Realtime Database URL
FIREBASE_DATABASE_URL=https://eventra4123-default-rtdb.asia-southeast1.firebasedatabase.app/

# 2. Server Port (Render sets this automatically; 3001 used for local testing)
PORT=3001

# 3. Firebase Admin SDK Credentials
# ------------------------------------------------------------
# Choose ONE of the following options:

# --- Option A (Easiest for Local Dev): File Path ---
# Download serviceAccountKey.json from Firebase Console and place it in notification-server/
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# --- Option B (Easiest for Render Web Service): Stringified JSON ---
# Wrap the entire JSON content from serviceAccountKey.json inside single quotes:
# FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"eventra4123",...}'

# --- Option C: Individual Environment Variables ---
FIREBASE_PROJECT_ID=eventra4123
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@eventra4123.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
